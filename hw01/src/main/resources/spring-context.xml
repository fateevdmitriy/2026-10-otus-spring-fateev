<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns="http://www.springframework.org/schema/beans"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
        http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean id="testReaderService" class="ru.otus.spring.service.TestReaderServiceImpl">
        <property name="csvFileName" value="/java_basic_test.csv"/>
    </bean>

    <bean id="testRunnerService" class="ru.otus.spring.service.TestRunnerServiceImpl"/>

    <bean id="personDao" class="ru.otus.spring.dao.PersonDaoSimple">
        <property name="defaultAge" value="0"/>
    </bean>

    <bean id="personService" class="ru.otus.spring.service.PersonServiceImpl">
        <constructor-arg index="0" ref="personDao"/>
    </bean>
</beans>
